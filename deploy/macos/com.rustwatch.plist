<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rustwatch</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{RUSTWATCHD_PATH}}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- D-06 pairing: a clean `stop` (exit 0) stays stopped, any crash
         (nonzero exit) restarts. A bare `KeepAlive=true` would resurrect
         intentional stops too. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- T-03-02: bound KeepAlive restart storms on poison input. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <!-- T-03-01: logs live under ~/Library/Logs, not world-writable /tmp
         (symlink-attack surface). Rendered by `rustwatch install`. -->
    <key>StandardOutPath</key>
    <string>{{LOGS_DIR}}/rustwatchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{LOGS_DIR}}/rustwatchd.err.log</string>
</dict>
</plist>
